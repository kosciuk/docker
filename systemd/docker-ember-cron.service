[Unit]
Description=Ember - procesar cola de emails pendientes
# BindsTo + After: si el contenedor no está levantado, esta unit no corre en
# lugar de fallar cada minuto con "No such container: ember-app" y llenar el
# journal sin procesar nada. docker-ember.service es oneshot con
# RemainAfterExit=yes, así que refleja si el compose está arriba.
Requires=docker.service
BindsTo=docker-ember.service
After=docker.service docker-ember.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec ember-app php bin/ember.php emails:process-pending
