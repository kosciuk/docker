APP_ENV=production
TZ=America/Argentina/Buenos_Aires

# Al menos 32 caracteres aleatorios. Si cambia, se invalidan todos los tokens
# emitidos.
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_DE_32_CHARS_O_MAS
JWT_ISSUER=https://api.partidodelasoledad.com.ar
APP_URL=https://api.partidodelasoledad.com.ar

# Token de GitHub (fine-grained, sólo lectura, con acceso a los repos privados
# linkedcode/*) para que composer pueda bajar las dependencias.
COMPOSER_AUTH={"github-oauth":{"github.com":"GITHUB_PAT_AQUI"}}

DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=pdls
DB_USER=pdls_user
DB_PASS=change-me
