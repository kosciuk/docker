# Entorno del contenedor. La configuración de la aplicación NO está acá:
# vive en /var/www/liberamerkato/api/config/config.prod.php, que se mantiene
# a mano en el VPS y no se versiona (plantilla en config.prod.php.example).
#
# Un solo archivo por entorno: base, JWT, URLs y OAuth van todos ahí.

APP_ENV=prod
TZ=America/Argentina/Buenos_Aires

# Token de GitHub para que el `composer install` del entrypoint pueda bajar
# los repos privados linkedcode/*. Es la única credencial que queda acá,
# y es de build: la app no la usa.
COMPOSER_AUTH={"github-oauth":{"github.com":"ghp_xxx"}}
