APP_ENV=prod
TZ=America/Argentina/Buenos_Aires

# Al menos 32 caracteres aleatorios (openssl rand -hex 32). Si cambia, se
# invalidan todos los tokens emitidos: los usuarios quedan deslogueados.
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_DE_32_CHARS_O_MAS
JWT_ISSUER=https://api.liberamerkato.com
APP_URL=https://api.liberamerkato.com

COMPOSER_AUTH={"github-oauth":{"github.com":"ghp_xxx"}}

DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=liberamerkato
DB_USER=liberamerkato_user
DB_PASS=change-me
