APP_ENV=production
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=ember
DB_USER=ember
DB_PASS=secret
SMTP_PASS_KEY=cambia_esto_por_una_clave_segura_de_al_menos_32_chars
QUEUE_BATCH_SIZE=50
QUEUE_MAX_ATTEMPTS=3
TZ=America/Argentina/Buenos_Aires

# Token de GitHub (fine-grained, solo lectura, con acceso a los repos de la org
# linkedcode) para que composer pueda bajar las dependencias linkedcode/* privadas.
COMPOSER_AUTH={"github-oauth":{"github.com":"GITHUB_PAT_AQUI"}}

