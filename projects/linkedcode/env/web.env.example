APP_ENV=production
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=linkedcode_auth
DB_USER=auth_user
DB_PASS=secret
TZ=America/Argentina/Buenos_Aires
# GitHub Personal Access Token con permiso de lectura sobre los repos privados
# linkedcode/* (auth-middleware, csrf-middleware, notenv, jwt-service, jwt-contracts).
# Se lo pasa a composer dentro del contenedor para que pueda descargarlos (composer
# install lo corre el entrypoint de la imagen). Sin esto falla con 404 al bajar dist.
COMPOSER_AUTH={"github-oauth":{"github.com":"GITHUB_PAT_AQUI"}}
