# Sólo lo que necesita el contenedor. La configuración de la app, secretos
# incluidos (base, JWT, OAuth, URLs), va en api/config/config.prod.php.
APP_ENV=prod
TZ=America/Argentina/Buenos_Aires
# Token de GitHub para que composer baje los linkedcode/* privados.
COMPOSER_AUTH={"github-oauth":{"github.com":"GITHUB_PAT_AQUI"}}
